# Inputs are committed, build output is not.
#
# Kept: the raw datasets in data/raw, the trained models and SHAP background
# samples in artifacts/, the chapter sources in docs/chapters, the captured UI
# screenshots in docs/figures/ui_*.png, and the reference papers in papers/.
# A fresh clone still runs without fetching or training.

# Built documents - scripts/build_report.py and scripts/build_deck.py
docs/IHACDP_Report.pdf
docs/IHACDP_Report.html
docs/IHACDP_Presentation.pptx

# Generated figures - scripts/make_figures.py rebuilds every fig_*.png.
# docs/figures/ui_*.png are screenshots of the running app, not generated by
# any script, so they stay tracked or the report build loses its Chapter 4
# figures.
docs/figures/fig_*.png

# Virtual environment - 590 MB of binaries compiled for one machine and Python
# version. setup.sh recreates it; committing it would break every other Mac.
.venv/

# Python bytecode and test caches - regenerated on every run
__pycache__/
*.pyc
.pytest_cache/

# macOS Finder metadata
.DS_Store
**/.DS_Store
